# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.

# Discord Developer Portal > 내 애플리케이션 > Bot > Reset Token 으로 받은 봇 토큰
DISCORD_TOKEN=

# 봇 서버 포트 (기본 8080)
# QUICKTTS_PORT=8080
# docker compose 로 띄운 봇 서버를 이 PC 의 몇 번 포트로 열지 (기본 8080). 8080 을 다른 프로그램이 쓰고 있으면 바꾼다
# QUICKTTS_HOST_PORT=8090

# 등록된 기기, 목소리 설정을 저장할 DB (기본: 실행 위치의 data/ 폴더에 H2 파일, MySQL 호환 모드)
# QUICKTTS_DB_URL=jdbc:h2:file:./data/quicktts;MODE=MySQL
# 개발 PC 에서 Docker 로 MySQL 을 띄워 쓰려면 true (compose.yaml, Docker Desktop 필요). 위 QUICKTTS_DB_URL 보다 먼저다.
# QUICKTTS_DEV_MYSQL=true
# MySQL 을 쓸 때 (배포 서버)
# QUICKTTS_DB_URL=jdbc:mysql://localhost:3306/quicktts?connectionTimeZone=UTC
# QUICKTTS_DB_USERNAME=quicktts
# QUICKTTS_DB_PASSWORD=

# 음성을 만드는 synthesis 서비스 주소 (기본: bootRun 으로 함께 띄운 http://localhost:8082)
# QUICKTTS_SYNTHESIS_URL=http://localhost:8082

# 목소리를 고르지 않은 사람에게 쓸 목소리 (기본: edge:ko-KR-SunHiNeural). synthesis 서비스가 읽는다.
# QUICKTTS_DEFAULT_VOICE=edge:ko-KR-SunHiNeural

# 웹 API 문서(/swagger-ui.html, /v3/api-docs)를 열지 (기본 true). 공개 서버에서 숨기려면 false
# QUICKTTS_API_DOCS_ENABLED=true

# 웹 API 사용량 제한 (ADR 0069). 기기 토큰이 있는 요청은 디스코드 사용자마다 1분에 60번, 기기 등록은 IP 마다 1분에 10번이 기본이다.
# QUICKTTS_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# QUICKTTS_RATE_LIMIT_REGISTRATIONS_PER_MINUTE=10

# ---- 배포: 이 PC 를 배포 서버로 띄울 때만 (compose.prod.yaml, ADR 0068) ----
# 띄울 서버 이미지 태그. GitHub 저장소 > Packages > quicktts-bot-server 에서 가장 최근 main-<커밋 7자리> 를 고른다.
# QUICKTTS_IMAGE_TAG=main-b8cc839
# 운영 MySQL 비밀번호. 처음 띄울 때 정한 값이 DB 에 남으므로 나중에 바꾸려면 MySQL 안에서 ALTER USER 도 한다.
# QUICKTTS_PROD_DB_PASSWORD=
# QUICKTTS_PROD_DB_ROOT_PASSWORD=
# 고장 알림을 받을 디스코드 채널 웹훅 주소 (ADR 0074). 채널 설정 > 연동 > 웹후크 > 새 웹후크 > 웹후크 URL 복사
# QUICKTTS_ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# 하루 한 번 DB 덤프를 남길 폴더와 남길 날 수 (ADR 0073). OneDrive·Google Drive 처럼 다른 곳에 올라가는 폴더를 추천한다.
# Windows 경로는 슬래시로 쓴다. 예: C:/Users/<이름>/OneDrive/quicktts-backups
# QUICKTTS_BACKUP_DIR=./backups
# QUICKTTS_BACKUP_KEEP_DAYS=14
